+				VALUES ('device-1', 1, 'Device', 'mqtt', 0), ('device-2', 1, 'Other device', 'mqtt', 1);
+			INSERT INTO device_resolution_keys (endpoint_id, device_uuid, kind, value)
+				VALUES (1, 'device-1', 'serial', 'fixture');
