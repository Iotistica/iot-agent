{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"types": ["jest", "node"],
		"isolatedModules": true,
		"rootDir": "..",
		"noEmit": true,
		"module": "Node16",
		"moduleResolution": "Node16"
	},
	"include": [
		"**/*.ts",
		"**/*.spec.ts"
	],
	"exclude": [
		"../node_modules",
		"../dist"
	]
}
